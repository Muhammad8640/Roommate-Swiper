HOST=127.0.0.1
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_SECRET_KEY=replace-with-server-secret-or-service-role-key
PHOTO_BUCKET=profile-photos
DATABASE_URL=postgresql://postgres:encoded-password@your-database-host:5432/postgres
DB_SSL=true
CORS_ORIGINS=http://localhost:5173
# Optional: only needed if DATABASE_URL uses a restricted backend login.
# MIGRATION_DATABASE_URL=postgresql://postgres:encoded-password@your-database-host:5432/postgres
